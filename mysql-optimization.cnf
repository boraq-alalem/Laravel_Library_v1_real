[mysqld]
# Query Cache
query_cache_type = 1
query_cache_size = 256M
query_cache_limit = 2M

# InnoDB Buffer Pool
innodb_buffer_pool_size = 1G
innodb_buffer_pool_instances = 8

# Connection Settings
max_connections = 200
max_connect_errors = 1000000

# Query Optimization
tmp_table_size = 256M
max_heap_table_size = 256M
join_buffer_size = 4M
sort_buffer_size = 4M

# Logging
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2

# Performance Schema
performance_schema = ON