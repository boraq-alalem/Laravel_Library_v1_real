# تحسين الأداء
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
QUEUE_FAILED_DRIVER=database

# Laravel Octane
OCTANE_SERVER=swoole
OCTANE_WORKERS=4
OCTANE_PORT=8000

# Database optimization
DB_CONNECTION=mysql
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Telescope (للتطوير فقط)
TELESCOPE_ENABLED=false

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=error